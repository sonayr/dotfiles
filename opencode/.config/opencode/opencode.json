{
    "$schema": "https://opencode.ai/config.json",
    "provider":{
        "google":{
            "options":{
                "baseURL":"https://generativelanguage.googleapis.com/v1beta/"
            }
        }
    },
    "mcp": {
        "atlassian": {
          "type": "local",
          "command": ["uvx", "mcp-atlassian"],
          "environment": {
            "JIRA_URL": "https://nestoca.atlassian.net",
            "JIRA_USERNAME": "ryan@nesto.ca",
            "JIRA_API_TOKEN": "{env:JIRA_API_KEY}",
            "CONFLUENCE_URL": "https://nestoca.atlassian.net/wiki",
            "CONFLUENCE_USERNAME": "ryan@nesto.ca",
            "CONFLUENCE_API_TOKEN": "{env:JIRA_API_KEY}"
          },
          "enabled": true
        },

        "salesforce-dx": {
           "type": "local",
           "command": ["npx","-y", "@salesforce/mcp",
              "--orgs", "ryanScratch",
              "--toolsets", "orgs,metadata,data,users",
              "--tools", "run_apex_test",
              "--allow-non-ga-tools"],
           "enabled": true
        },
        "granola": {
           "type": "local",
           "command": ["npx", "-y", "granola-simple-mcp"],
           "environment": {
             "GRANOLA_API_KEY": "{env:GRANOLA_API_KEY}"
           },
           "enabled": true
        },
        "obsidian": {
          "type": "local",
          "command": ["npx", "-y", "@mauricio.wolff/mcp-obsidian@latest", "~/Documents/Obsidian"]
        }
  },
  "permission": { "skill": {
      "*": "ask"
    }
  }
}
