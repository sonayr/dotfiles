#!/bin/bash
set -e

SECRETS_FILE="$HOME/.zsh_secrets"
NOTE_NAME="Dotfiles Secrets"

echo "==> Syncing dotfiles secrets from LastPass..."

if ! command -v lpass >/dev/null 2>&1; then
    echo "Error: 'lpass' (lastpass-cli) is not installed."
    echo "Install it with: brew install lastpass-cli"
    exit 1
fi

if ! lpass status -q; then
    echo "LastPass is not logged in. Logging in..."
    if [ -n "$1" ]; then
        lpass login "$1"
    else
        lpass login
    fi
fi

echo "Fetching '$NOTE_NAME' from LastPass..."
if ! lpass show --notes "$NOTE_NAME" > "$SECRETS_FILE.tmp" 2>/dev/null; then
    echo ""
    echo "Warning: Could not find a Secure Note named '$NOTE_NAME' in LastPass."
    echo "Please create a Secure Note in LastPass with the title '$NOTE_NAME' containing your environment variables, e.g.:"
    echo "  export GRANOLA_API_KEY=\"...\""
    echo "  export JIRA_API_KEY=\"...\""
    rm -f "$SECRETS_FILE.tmp"
    exit 1
fi

mv "$SECRETS_FILE.tmp" "$SECRETS_FILE"
chmod 600 "$SECRETS_FILE"

echo " Successfully synced secrets to $SECRETS_FILE (permissions: 600)"
